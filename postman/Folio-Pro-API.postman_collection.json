{
  "info": {
    "_postman_id": "604a41c0-7ba8-4edc-bfec-bc2fb43a8e68",
    "name": "Folio Pro API",
    "description": "API smoke and CRUD requests for Folio Pro. Select the Local or Dev environment. Authentication is not implemented. The CSV import request requires selecting the CSV file in the form-data body after importing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Portfolios",
      "item": [
        {
          "name": "List portfolios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolios?page=0&size=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "portfolios"],
              "query": [
                {"key": "page", "value": "0"},
                {"key": "size", "value": "15"}
              ]
            }
          }
        },
        {
          "name": "Create portfolio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Portfolio created', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.id) pm.environment.set('portfolioId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman sample portfolio\",\n  \"country\": \"United States\",\n  \"currency\": \"USD\",\n  \"assetType\": \"Stocks & ETFs\",\n  \"holdings\": [\n    {\n      \"symbol\": \"AAPL\",\n      \"instrument\": \"Apple Inc.\",\n      \"quantity\": 2,\n      \"averageCost\": 150,\n      \"marketValue\": null,\n      \"currency\": \"USD\"\n    }\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "portfolios"]
            }
          }
        },
        {
          "name": "Get portfolio by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "portfolios", "{{portfolioId}}"]
            }
          }
        },
        {
          "name": "Replace portfolio by ID",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman sample portfolio updated\",\n  \"country\": \"United States\",\n  \"currency\": \"USD\",\n  \"assetType\": \"Stocks & ETFs\",\n  \"holdings\": [\n    {\n      \"symbol\": \"MSFT\",\n      \"instrument\": \"Microsoft Corporation\",\n      \"quantity\": 1,\n      \"averageCost\": 400,\n      \"marketValue\": null,\n      \"currency\": \"USD\"\n    }\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "portfolios", "{{portfolioId}}"]
            }
          }
        },
        {
          "name": "Delete portfolio by ID (destructive)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "portfolios", "{{portfolioId}}"]
            },
            "description": "Deletes the portfolio identified by portfolioId. Run only when you intend to remove the test portfolio."
          }
        }
      ]
    },
    {
      "name": "Watchlists",
      "item": [
        {
          "name": "List watchlists with tickers (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns paginated watchlists', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.content).to.be.an('array');",
                  "  pm.expect(body.page).to.be.a('number');",
                  "  pm.expect(body.size).to.be.a('number');",
                  "  pm.expect(body.totalElements).to.be.a('number');",
                  "  pm.expect(body.totalPages).to.be.a('number');",
                  "  body.content.forEach(function (watchlist) {",
                  "    pm.expect(watchlist).to.have.property('name');",
                  "    pm.expect(watchlist.items).to.be.an('array');",
                  "    watchlist.items.forEach(function (item) {",
                  "      pm.expect(item).to.have.property('symbol');",
                  "      pm.expect(item).to.have.property('name');",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists"]
            },
            "description": "Returns every watchlist (a JSON array, not paginated) with each watchlist's full items array (symbol, name, isFavorite). Omit market to include both US and India; optionally add market=US or market=India to filter."
          }
        },
        {
          "name": "Create watchlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Watchlist created', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.id) pm.environment.set('watchlistId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman sample watchlist\",\n  \"market\": \"US\",\n  \"userId\": 1\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists"]
            },
            "description": "market accepts US, USA or India. If the user already has a watchlist with this name in that market (case-insensitive), the existing watchlist is returned and no new one is created."
          }
        },
        {
          "name": "Import CSV into USA or India watchlist table",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Choose a column-oriented CSV. The first row contains watchlist names; subsequent rows contain stock symbols."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/import?market={{importMarket}}&userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "import"],
              "query": [{"key": "market", "value": "{{importMarket}}"}, {"key": "userId", "value": "{{userId}}"}]
            },
            "description": "Set importMarket to USA (or US) or India and userId to the owner. Select the CSV file in Body > form-data > file after importing this collection. Imports only add: a column named like one of the user's existing watchlists in that market adds its new symbols there and skips ones already present; other columns create new watchlists."
          }
        },
        {
          "name": "Export watchlists as CSV (all in market)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/export?market={{importMarket}}&userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "export"],
              "query": [{"key": "market", "value": "{{importMarket}}"}, {"key": "userId", "value": "{{userId}}"}]
            },
            "description": "Downloads every watchlist the user has in the market as CSV. Row 1 holds the watchlist names (one per column); rows 2 onwards hold each watchlist's ticker symbols in its column. Cells that would start a spreadsheet formula (=, +, -, @) get a leading apostrophe so they open as plain text. The file can be imported again unchanged. Use Send and Download to save it."
          }
        },
        {
          "name": "Export one watchlist as CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/export?market={{importMarket}}&userId={{userId}}&watchlistId={{watchlistId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "export"],
              "query": [{"key": "market", "value": "{{importMarket}}"}, {"key": "userId", "value": "{{userId}}"}, {"key": "watchlistId", "value": "{{watchlistId}}"}]
            },
            "description": "Same CSV format for a single watchlist. 404 if watchlistId is not one of the user's watchlists in that market."
          }
        },
        {
          "name": "Add stocks to USA watchlist (owner-checked)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\"symbol\": \"AAPL\", \"name\": \"Apple Inc.\"},\n    {\"symbol\": \"BRK.B\"}\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/us/{{watchlistId}}/items?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "us", "{{watchlistId}}", "items"],
              "query": [{"key": "userId", "value": "{{userId}}"}]
            },
            "description": "Saves 1-100 stocks into watchlist_items_usa. 201 with the saved items; 400 on a duplicate symbol; 404 for an India list or another user's list."
          }
        },
        {
          "name": "Remove stock from USA watchlist (owner-checked)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/us/{{watchlistId}}/items/AAPL?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "us", "{{watchlistId}}", "items", "AAPL"],
              "query": [{"key": "userId", "value": "{{userId}}"}]
            },
            "description": "Deletes one stock from a USA watchlist owned by userId. 204, or 404 if the list or symbol is not found."
          }
        },
        {
          "name": "Add stocks to India watchlist (owner-checked)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\"symbol\": \"RELIANCE\"},\n    {\"symbol\": \"M&M\"}\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/india/{{watchlistId}}/items?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "india", "{{watchlistId}}", "items"],
              "query": [{"key": "userId", "value": "{{userId}}"}]
            },
            "description": "Saves 1-100 NSE stocks into watchlist_items_india. Needs an India watchlistId. 201 with the saved items; 400 on a duplicate symbol; 404 for a USA list or another user's list."
          }
        },
        {
          "name": "Remove stock from India watchlist (owner-checked)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/india/{{watchlistId}}/items/M%26M?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "india", "{{watchlistId}}", "items", "M%26M"],
              "query": [{"key": "userId", "value": "{{userId}}"}]
            },
            "description": "Deletes one stock from an India watchlist owned by userId. URL-encode & as %26. 204, or 404 if the list or symbol is not found."
          }
        },
        {
          "name": "Get watchlist with items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/{{watchlistId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "{{watchlistId}}"]
            },
            "description": "Returns the watchlist with all of its items (not paginated)."
          }
        },
        {
          "name": "Rename watchlist",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman sample watchlist renamed\",\n  \"market\": \"US\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/{{watchlistId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "{{watchlistId}}"]
            },
            "description": "The market must match the existing watchlist. Change both this request body and the watchlist if testing India. Returns 400 if the owner already has another watchlist with that name in the market."
          }
        },
        {
          "name": "Mark watchlist as favorite (star)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isFavorite\": true\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/{{watchlistId}}/favorite?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "{{watchlistId}}", "favorite"],
              "query": [{"key": "userId", "value": "{{userId}}"}]
            },
            "description": "Sets is_favorite on a USA or India watchlist. Send {\"isFavorite\": false} to un-star. Favorites are listed first by GET /watchlists. 404 if the watchlist belongs to another user."
          }
        },
        {
          "name": "Add items to watchlist",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"symbol\": \"AAPL\",\n      \"name\": \"Apple Inc.\",\n      \"isFavorite\": true\n    },\n    {\n      \"symbol\": \"MSFT\",\n      \"name\": \"Microsoft Corporation\",\n      \"isFavorite\": false\n    }\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/{{watchlistId}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "{{watchlistId}}", "items"]
            }
          }
        },
        {
          "name": "Update watchlist item",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"AAPL\",\n  \"name\": \"Apple Inc.\",\n  \"isFavorite\": true\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/{{watchlistId}}/items/{{symbol}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "{{watchlistId}}", "items", "{{symbol}}"]
            }
          }
        },
        {
          "name": "Remove watchlist item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/{{watchlistId}}/items/{{symbol}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "{{watchlistId}}", "items", "{{symbol}}"]
            }
          }
        },
        {
          "name": "Delete watchlist (destructive)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watchlists/{{watchlistId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watchlists", "{{watchlistId}}"]
            },
            "description": "Deletes the watchlist and its items. Run only when you intend to remove the test watchlist."
          }
        }
      ]
    },
