    {
      "name": "Watchlist column preferences",
      "item": [
        {
          "name": "Get watchlist column preferences",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/watchlist-column-preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "watchlist-column-preferences"]
            },
            "description": "Returns the user's selected watchlist table columns ordered by displayOrder. 404 if the user has never saved columns (the UI then shows its defaults)."
          }
        },
        {
          "name": "Replace watchlist column preferences",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columns\": [\n    {\"columnKey\": \"symbol\", \"displayOrder\": 1},\n    {\"columnKey\": \"name\", \"displayOrder\": 2},\n    {\"columnKey\": \"price\", \"displayOrder\": 3},\n    {\"columnKey\": \"change\", \"displayOrder\": 4},\n    {\"columnKey\": \"marketCap\", \"displayOrder\": 5}\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/watchlist-column-preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "watchlist-column-preferences"]
            },
            "description": "Replaces the user's whole column selection. Column keys must be unique; displayOrder sets left-to-right order."
          }
        }
      ]
    }
  ],
